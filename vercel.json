{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "functions": {
    "api/products.js": {
      "maxDuration": 60
    },
    "api/product-page.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/produkt/:slug",
      "destination": "/api/product-page?slug=:slug"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
